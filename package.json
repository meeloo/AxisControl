{
  "name": "axiscontrol",
  "version": "0.1.3",
  "description": "A CNC-first web front end for RepRapFirmware controllers",
  "license": "Apache-2.0",
  "author": "Sébastien Métrot",
  "repository": {
    "type": "git",
    "url": "https://github.com/meeloo/AxisControl.git"
  },
  "homepage": "https://github.com/meeloo/AxisControl",
  "bugs": {
    "url": "https://github.com/meeloo/AxisControl/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --watch --serve",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "camera-proxy": "node tools/camera-proxy.mjs",
    "gcode-index": "node tools/build-gcode-index.mjs",
    "merge-oracle": "node tools/merge-oracle.mjs",
    "rewrite-check": "node tools/rewrite-check.mjs",
    "gcode-params": "node tools/gcode-params-check.mjs",
    "hershey-check": "node tools/hershey-check.mjs",
    "outline-check": "node tools/outline-check.mjs",
    "vcarve-check": "node tools/vcarve-check.mjs",
    "steps-check": "node tools/steps-check.mjs",
    "fontstore-check": "node tools/fontstore-check.mjs",
    "velocity-check": "node tools/velocity-check.mjs"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "dockview-core": "^7.0.4",
    "lit": "^3.2.1",
    "mpegts.js": "^1.8.0",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@duet3d/objectmodel": "^3.6.3",
    "@types/opentype.js": "^1.3.10",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
